                    <widget class="QGroupBox">
                        <property name="name">
                            <cstring>registrarGroupBox</cstring>
                        </property>
                        <property name="title">
                            <string>Registrar</string>
                        </property>
                        <grid>
                            <property name="name">
                                <cstring>unnamed</cstring>
                            </property>
                            <widget class="QLabel" row="0" column="0">
                                <property name="name">
                                    <cstring>registrarTextLabel</cstring>
                                </property>
                                <property name="text">
                                    <string>&amp;Registrar:</string>
