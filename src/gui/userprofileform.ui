            </widget>
            <widget class="QWidget">
                <property name="name">
                    <cstring>pageSipServer</cstring>
                </property>
                <attribute name="id">
                    <number>1</number>
                </attribute>
                <vbox>
                    <property name="name">
                        <cstring>unnamed</cstring>
                    </property>
                    <widget class="QLabel">
