<!DOCTYPE UI><UI version="3.1" stdsetdef="1">
<class>DtmfForm</class>
<widget class="QDialog">
    <property name="name">
        <cstring>DtmfForm</cstring>
    </property>
    <property name="geometry">
        <rect>
            <x>0</x>
            <y>0</y>
            <width>466</width>
            <height>233</height>
        </rect>
    </property>
    <property name="sizePolicy">
